#include <stdio.h>

#define MAX_ROWS 100
#define MAX_COLS 100

// --- ПОДПРОГРАММА (Первая подзадача) ---
// Вычисляет произведение отрицательных элементов в заданном столбце col.
// Возвращает 0.0, если отрицательных элементов нет.
double getNegativeProduct(double A[][MAX_COLS], int rows, int col) {
    double product = 1.0;
    int found = 0; // Флаг: 0 - не найдено, 1 - найдено

    for (int i = 0; i < rows; i++) {
        if (A[i][col] < 0) {
            product *= A[i][col];
            found = 1;
        }
    }

    if (found == 0) {
        return 0.0; // Особое решение: нет отрицательных
    }
    
    return product;
}

int main() {
    int m, n;
    double Y = 0.0;

    // 1. Ввод размеров матрицы
    printf("Введите количество строк (m) и столбцов (n): ");
    if (scanf("%d %d", &m, &n) != 2 || m <= 0 || m > MAX_ROWS || n <= 0 || n > MAX_COLS) {
        printf("Ошибка: неверный размер матрицы.\n");
        return 1;
    }

    double A[MAX_ROWS][MAX_COLS];

    // 2. Ввод элементов матрицы
    printf("Введите элементы матрицы A (%d x %d):\n", m, n);
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%lf", &A[i][j]);
        }
    }

    // Массив для хранения произведений P (P[0] - для 1-го столбца, P[n-1] - для n-го)
    double P[MAX_COLS];

    // 3. ИСПОЛЬЗОВАНИЕ ПОДПРОГРАММЫ (Вторая подзадача)
    printf("\nРезультаты по столбцам:\n");
    for (int j = 0; j < n; j++) {
        P[j] = getNegativeProduct(A, m, j);

        // Проверка на "особое решение"
        if (P[j] == 0.0) {
            printf("\n[ОСОБОЕ РЕШЕНИЕ]\n");
            printf("В столбце %d нет отрицательных элементов.\n", j + 1);
            printf("Выполнение программы прекращено.\n");
            return 0; // Аварийное завершение
        }
        
        printf("P_%d = %.2lf\n", j + 1, P[j]);
    }

    // 4. Вычисление выражения Y (Обычное решение)
    // Формула: Y = (1 - Pn)^2 + (2 - Pn-1)^2 + ... + (n - P1)^2
    // Обратите внимание: индексация в C начинается с 0.
    // P[n-1] это Pn, P[0] это P1.
    
    Y = 0.0;
    for (int i = 0; i < n; i++) {
        // i+1 — это порядковый номер в формуле (1, 2, ..., n)
        // P[n - 1 - i] — это произведение от Pn до P1 в обратном порядке
        double term = (i + 1) - P[n - 1 - i];
        Y += term * term; // Возводим в квадрат и суммируем
    }

    printf("\n[ОБЫЧНОЕ РЕШЕНИЕ]\n");
    printf("Вычисленное значение Y = %.4lf\n", Y);

    return 0;
}