#include <stdio.h>

#define MAX_SIZE 100

// --- ПОДПРОГРАММА (первая подзадача) ---
// Заменяет элементы < C на C, возвращает число замен
int replaceLessThan(double arr[], int n, double C) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] < C) {
            arr[i] = C;
            count++;
        }
    }
    return count;
}

int main() {
    double A[MAX_SIZE], B[MAX_SIZE];
    int nA, nB;

    // --- Ввод массива A ---
    do {
        printf("Введите размер массива A (1-%d): ", MAX_SIZE);
        scanf("%d", &nA);
    } while (nA < 1 || nA > MAX_SIZE);

    printf("Введите элементы массива A:\n");
    for (int i = 0; i < nA; i++) {
        scanf("%lf", &A[i]);
    }

    // --- Ввод массива B ---
    do {
        printf("Введите размер массива B (1-%d): ", MAX_SIZE);
        scanf("%d", &nB);
    } while (nB < 1 || nB > MAX_SIZE);

    printf("Введите элементы массива B:\n");
    for (int i = 0; i < nB; i++) {
        scanf("%lf", &B[i]);
    }

    // --- ПРИМЕНЕНИЕ К РАЗЛИЧНЫМ ОБЪЕКТАМ (вторая подзадача) ---
    int countA = replaceLessThan(A, nA, -5.7);
    int countB = replaceLessThan(B, nB, 3.8);

    // Вывод результатов согласно условию
    printf("\n--- Результаты ---\n");
    if (countA > countB) {
        printf("Больше замен в массиве A (%d). Измененный массив:\n", countA);
        for (int i = 0; i < nA; i++) {
            printf("%.1lf ", A[i]);
        }
        printf("\n");
    } else if (countB > countA) {
        printf("Больше замен в массиве B (%d). Измененный массив:\n", countB);
        for (int i = 0; i < nB; i++) {
            printf("%.1lf ", B[i]);
        }
        printf("\n");
    } else {
        printf("Количество замен равно: %d\n", countA);
    }

    return 0;
}